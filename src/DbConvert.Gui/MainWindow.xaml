<Window x:Class="DbConvert.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DbConvert.Gui"
        mc:Ignorable="d"
        Title="DBConvertDB — 数据库结构与数据迁移"
        Height="920" Width="1240"
        MinHeight="780" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="12"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentDark" Color="#1D4ED8" />
        <SolidColorBrush x:Key="Ink" Color="#16233A" />
        <SolidColorBrush x:Key="Muted" Color="#64748B" />
        <SolidColorBrush x:Key="Line" Color="#E3E9F2" />
        <SolidColorBrush x:Key="FieldLine" Color="#D8DEE8" />

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="GroupBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="16,6,16,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#1B2A4A" Opacity="0.07" BlurRadius="16" ShadowDepth="2" Direction="270" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="16,12,16,2">
                                    <Border Width="3" Height="14" CornerRadius="2" Background="{StaticResource Accent}"
                                            VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <ContentPresenter ContentSource="Header" TextElement.FontSize="13.5"
                                                      TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Ink}" />
                                </StackPanel>
                                <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#BBD3FB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B7CBF3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B7CBF3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Margin="2,1" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF4FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3EDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="{StaticResource FieldLine}"
                                    BorderThickness="1" CornerRadius="8" />
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  VerticalAlignment="Center" IsHitTestVisible="False" />
                                <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0" Stroke="#8496AE" StrokeThickness="1.6"
                                      VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                                   PlacementTarget="{Binding ElementName=Bd}">
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource FieldLine}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#12203A" Opacity="0.16" BlurRadius="18" ShadowDepth="4" Direction="270" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="4">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B7CBF3" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复选 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" Background="#FFFFFF"
                                    BorderBrush="#C5D0E0" BorderThickness="1" VerticalAlignment="Center" />
                            <TextBlock x:Name="Tick" Text="&#x2713;" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource Accent}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C7D3E4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="#FFFFFF" BorderBrush="#DCE3EF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F9FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B7CBF3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF1FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FB" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF1FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE9FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 表格 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F6FC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E5EBF5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F8FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F0FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#2A3A52" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellCheck" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 日志 -->
        <Style x:Key="LogBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B9C7DA" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, 微软雅黑" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="SelectionBrush" Value="#27406B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 标题栏按钮 -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="#5A6B82" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E7EDF7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8E2F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Foreground" Value="#5A6B82" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C50F1F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#DCE4EF" Background="#F4F6FB">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏（Captioned 区域，可拖动 / 双击最大化） -->
            <Grid Grid.Row="0" Height="56" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="30" Height="30" CornerRadius="9" Margin="18,0,10,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2F6BF0" Offset="0" />
                            <GradientStop Color="#0EA5E9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="DB" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DBConvertDB" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="源库 ⇄ 目标库 · 结构与数据迁移" FontSize="10.5" Foreground="#8A97AB"
                               Margin="10,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="13" Padding="11,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="12 种数据库 · 双向迁移" FontSize="10.5" Foreground="#5A6B82" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnMin" Style="{StaticResource TitleButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMin_Click"
                            ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource TitleButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnMax_Click"
                            ToolTip="最大化 / 还原">
                        <TextBlock x:Name="IcoMax" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource TitleCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnClose_Click"
                            ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,4,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <!-- 连接区 -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="源库" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="类型" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SrcKind" SelectionChanged="SrcKind_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="主机" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SrcHost" Text="127.0.0.1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SrcPort" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock x:Name="SrcDbLabel" Text="库 / 服务名" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SrcDb" ToolTip="Oracle 填服务名，SQLite 填文件路径" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="用户" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SrcUser" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="SrcPwd" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="连接串（可留空）" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SrcConn"
                                     ToolTip="留空则用上面的字段拼装；也可以直接粘贴完整连接串（此时忽略其它字段）" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnTestSrc" Content="测试连接" Style="{StaticResource MiniButton}"
                                VerticalAlignment="Bottom" Click="BtnTestSrc_Click" />
                    </Grid>
                </Grid>
            </GroupBox>

            <Button Grid.Column="1" x:Name="BtnSwap" Width="34" Height="34" Padding="0"
                    Background="#EAF1FF" BorderBrush="#CFE0FF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                    ToolTip="点击交换源库与目标库的全部连接信息（类型、主机、端口、库、用户、密码、连接串）"
                    Click="SwapEndpoints_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwapBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwapBorder" Property="Background" Value="#DCE8FF" />
                                <Setter TargetName="SwapBorder" Property="BorderBrush" Value="#9FBDFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwapBorder" Property="Background" Value="#C9DCFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="⇄" FontSize="16" Foreground="{StaticResource Accent}" />
            </Button>

            <GroupBox Grid.Column="2" Header="目标库" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="类型" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="DstKind" SelectionChanged="DstKind_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="主机" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DstHost" Text="127.0.0.1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DstPort" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock x:Name="DstDbLabel" Text="库 / Schema" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DstDb" ToolTip="达梦可填 schema，留空用登录用户" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="用户" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DstUser" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="DstPwd" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="连接串（可留空）" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DstConn" ToolTip="留空则用上面的字段拼装" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnTestDst" Content="测试连接" Style="{StaticResource MiniButton}"
                                VerticalAlignment="Bottom" Click="BtnTestDst_Click" />
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 迁移选项：横向一条，避免右侧面板拥挤 -->
        <GroupBox Grid.Row="2" Header="迁移选项" Style="{StaticResource Card}" Padding="16,1,16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Rows="1" Columns="6">
                    <CheckBox x:Name="ChkDrop" Content="先删除同名目标表（DROP）" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkTruncate" Content="清空目标表已有数据" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkIndex" Content="创建索引" IsChecked="True" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkIndexAfter" Content="数据搬完再建索引（更快）" IsChecked="True" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkSkipUnsupported" Content="跳过无法映射的列" IsChecked="True" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkScriptOnly" Content="只生成 SQL（不连目标库）" VerticalAlignment="Center"
                              ToolTip="只导出表/视图/过程/函数/触发器结构 SQL，不含 INSERT 数据，也不连接目标库"
                              Checked="ChkScriptOnly_Changed" Unchecked="ChkScriptOnly_Changed" />
                </UniformGrid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource Line}" Margin="0,9,0,9" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="校验方式" VerticalAlignment="Center" Foreground="#475569" FontSize="12" Margin="2,0,12,0" />
                    <ComboBox Grid.Column="1" x:Name="CmbVerify" Margin="0,0,22,0">
                        <ComboBoxItem Content="checksum" IsSelected="True" />
                        <ComboBoxItem Content="count" />
                        <ComboBoxItem Content="none" />
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="标识符大小写" VerticalAlignment="Center" Foreground="#475569" FontSize="12" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="3" x:Name="CmbCase" Margin="0,0,22,0">
                        <ComboBoxItem Content="auto" IsSelected="True" />
                        <ComboBoxItem Content="preserve" />
                        <ComboBoxItem Content="upper" />
                        <ComboBoxItem Content="lower" />
                    </ComboBox>

                    <TextBlock Grid.Column="4" Text="自增列方式" VerticalAlignment="Center" Foreground="#475569" FontSize="12" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="5" x:Name="CmbIdentity" Margin="0,0,22,0">
                        <ComboBoxItem Content="auto" IsSelected="True" />
                        <ComboBoxItem Content="sequence" />
                        <ComboBoxItem Content="none" />
                    </ComboBox>

                    <TextBlock Grid.Column="6" Text="每批行数" VerticalAlignment="Center" Foreground="#475569" FontSize="12" Margin="0,0,12,0" />
                    <TextBox Grid.Column="7" x:Name="TxtBatch" Text="2000" Margin="0,0,22,0" />

                    <TextBlock Grid.Column="8" Text="输出目录" VerticalAlignment="Center" Foreground="#475569" FontSize="12" Margin="0,0,12,0" />
                    <TextBox Grid.Column="9" x:Name="TxtOut" Text="output" />
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 表列表 -->
        <GroupBox Grid.Row="3" Header="待迁移的表" Style="{StaticResource Card}" Padding="0,0,0,8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="勾选需要迁移的表，默认全选；列表为空时先点“读取源表结构”。"
                           FontSize="11.5" Foreground="{StaticResource Muted}" Margin="16,0,16,8" />
                <Border Grid.Row="1" Margin="10,0,10,0" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Background="#FFFFFF" ClipToBounds="True">
                    <Grid>
                    <DataGrid x:Name="DgTables" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF1F8" Background="Transparent"
                              BorderThickness="0" RowHeight="30" ColumnHeaderHeight="34"
                              SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0"
                              AlternatingRowBackground="#FBFCFE" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="迁" Binding="{Binding IsSelected, Mode=TwoWay}" Width="42"
                                                    ElementStyle="{StaticResource CellCheck}" />
                            <DataGridTextColumn Header="源表" Binding="{Binding SourceName}" Width="1.2*" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="目标表" Binding="{Binding TargetName}" Width="1.2*" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="预计行数" Binding="{Binding RowEstimate}" Width="110" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="列数" Binding="{Binding ColumnCount}" Width="60" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="240" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="还没有表结构 — 填好连接后点“读取源表结构”" FontSize="12.5" Foreground="#9AA9BF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=DgTables}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnLoad" Content="读取源表结构" Style="{StaticResource SoftButton}" />
            <Button Grid.Column="1" x:Name="BtnScript" Content="生成建表脚本" Style="{StaticResource SoftButton}" Margin="8,0,0,0" />
            <Button Grid.Column="2" x:Name="BtnPreview" Content="预览脚本" Style="{StaticResource GhostButton}" Margin="4,0,0,0" />
            <Button Grid.Column="3" x:Name="BtnMigrate" Content="开始迁移" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    ToolTip="连接目标库直接建表、搬数据并创建视图/过程/函数/触发器，不需要手工执行 schema.sql" />
            <Button Grid.Column="5" x:Name="BtnVerify" Content="只做校验" Style="{StaticResource GhostButton}" />
            <Button Grid.Column="6" x:Name="BtnOpenOut" Content="打开输出目录" Style="{StaticResource SoftButton}" Margin="6,0,0,0" />
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="5" Margin="0,14,0,0" CornerRadius="12" Background="#0E1729" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#0B1220" Opacity="0.18" BlurRadius="18" ShadowDepth="2" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,10,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="运行日志" Foreground="#E7EEF9" FontSize="12.5" FontWeight="SemiBold" />
                        <Border Background="#17233B" CornerRadius="9" Padding="9,3" Margin="12,0,0,0">
                            <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="#8EC5FF" FontSize="11.5" />
                        </Border>
                    </StackPanel>
                    <ProgressBar Grid.Column="2" x:Name="Prg" Height="8" IsIndeterminate="False"
                                 VerticalAlignment="Center" Foreground="#3B82F6" Background="#22314F"
                                 BorderThickness="0" />
                </Grid>

                <Border Grid.Row="1" Background="#0A1120" Padding="16,10,16,12">
                    <TextBox x:Name="TxtLog" Style="{StaticResource LogBox}" />
                </Border>
            </Grid>
        </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
