{
  "source": {
    "kind": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "database": "dbconvert_test",
    "user": "root",
    "password": "YOUR_PASSWORD"
  },
  "target": {
    "kind": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "database": "dbconvert_target",
    "user": "root",
    "password": "YOUR_PASSWORD",
    "schema": "dbconvert_target"
  },
  "options": {
    "mode": "both",
    "dropExisting": true,
    "batchSize": 500,
    "verifyMode": "checksum",
    "outDir": "samples/out-mysql2mysql",
    "identifierCase": "preserve",
    "directObjects": true
  },
  "tables": []
}


