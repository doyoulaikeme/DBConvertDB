{
  "source": {
    "kind": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "database": "dbconvert_test",
    "user": "root",
    "password": "YOUR_PASSWORD"
  },
  "target": { "kind": "sqlite", "database": "samples/from_mysql.db", "schema": "main" },
  "options": {
    "mode": "both",
    "dropExisting": true,
    "batchSize": 100,
    "verifyMode": "checksum",
    "outDir": "samples/out-frommysql",
    "identifierCase": "preserve"
  },
  "tables": []
}


